AWS_REGION=us-east-1
SHABA_DATA_FUNCTION=your-deployed-function-name
# Prefer a workload IAM role / temporary credentials. Never use NEXT_PUBLIC_ for AWS settings.
# For local development use an AWS CLI profile with lambda:InvokeFunction on this function only.
AWS_PROFILE=shaba

# Public B2 bucket/CDN base URL, including bucket path; used at build time.
B2_PUBLIC_BASE_URL=https://f000.backblazeb2.com/file/your-bucket

# Google admin sign-in. Exactly one verified email is allowed.
ADMIN_EMAIL=your-admin@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
SHABA_ADMIN_FUNCTION=your-deployed-admin-function-name

# B2 bucket-scoped application key, separate from AWS credentials.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your-bucket
B2_KEY_ID=
B2_APPLICATION_KEY=
