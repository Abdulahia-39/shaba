{
  "name": "shaba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "backend:build": "node scripts/build-backend-template.mjs",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:check": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "cf:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "cf:migrate:local": "wrangler d1 migrations apply shaba-data --local --config cloudflare/wrangler.jsonc",
    "cf:migrate:remote": "wrangler d1 migrations apply shaba-data --remote --config cloudflare/wrangler.jsonc",
    "data:export": "node scripts/export-aws-to-d1.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "mongoose": "^9.0.1",
    "next": "15.4.10",
    "next-auth": "^4.24.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-loading-indicators": "^1.0.1",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "wrangler": "4.149.0"
  }
}
